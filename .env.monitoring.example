# Recipients are resolved from active Main Admin and Moderator accounts in MongoDB.
# Internal monitoring works using the existing database. No SDK DSN or API key.
APP_RELEASE=
# Existing RESEND_API_KEY + EMAIL_FROM are used automatically, without SMTP.
# Optional SMTP fallback when Resend is not configured.
MONITOR_FROM_EMAIL=
MONITOR_SMTP_HOST=
MONITOR_SMTP_PORT=587
MONITOR_SMTP_SECURE=false
MONITOR_SMTP_USER=
MONITOR_SMTP_PASSWORD=
# Optional independent checker; set matching random >=32-character token there.
MONITOR_WATCHDOG_TOKEN=
