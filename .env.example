﻿NODE_ENV=development
PORT=3104
MONGODB_URI=mongodb://127.0.0.1:27017/onlyme_dev
CLIENT_URL=http://localhost:5173

# Welcome emails (Resend free tier: 100/day, 3,000/month).
# Create a sending-only API key at https://resend.com/api-keys.
# For real recipients, verify your domain and use an address on that domain.
RESEND_API_KEY=
EMAIL_FROM=@seen <welcome@your-verified-domain.com>
EMAIL_TIMEOUT_MS=10000

JWT_ACCESS_SECRET=replace_with_secure_access_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Keep all three Cloudinary values on the backend only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CONTENT_MAX_FILE_SIZE_BYTES=104857600

# Creator verification documents use authenticated Cloudinary assets and are
# streamed only through authorized backend endpoints.
VERIFICATION_MAX_FILE_SIZE_BYTES=10485760

# Internal Stars testing only. Keep false outside controlled environments.
ENABLE_ADMIN_STAR_CREDITS=false

# Isolated test database only. Financial integration tests drop this database.
# MongoDB transactions require a replica set or Atlas test cluster.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/onlyme_financial_test?replicaSet=rs0

# WebRTC calling. In production, point these at your self-hosted Coturn server.
WEBRTC_STUN_URLS=stun:turn.example.com:3478
WEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# Must match Coturn's static-auth-secret. Generates one-hour credentials per user.
WEBRTC_TURN_SECRET=
# Static credentials are supported only as a development fallback.
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

